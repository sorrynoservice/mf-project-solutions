{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kitchen-renovations",
      "destination": "/kitchens",
      "permanent": true
    },
    {
      "source": "/landscaping-pergolas",
      "destination": "/landscaping",
      "permanent": true
    },
    {
      "source": "/interior-design",
      "destination": "/design",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/residential/whole-house-renovations",
      "destination": "/house-renovations",
      "permanent": true
    },
    {
      "source": "/residential/extensions",
      "destination": "/home-extensions",
      "permanent": true
    },
    {
